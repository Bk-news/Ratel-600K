rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ضع هنا البريد الإلكتروني للحسابات الأربعة المسموح لها بدخول لوحة التحكم.
    // أي حساب آخر (حتى لو سجّل في Firebase) لن يقرأ ولن يكتب شيئًا.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'email1@example.com',
          'email2@example.com',
          'email3@example.com',
          'email4@example.com'
        ];
    }

    // ملخص عام تقرؤه الصفحة العامة (أرقام فقط، بدون أسماء متبرعين أو أعضاء)
    match /public/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // البيانات التفصيلية: للأعضاء فقط
    match /income/{id}     { allow read, write: if isAdmin(); }
    match /activities/{id} { allow read, write: if isAdmin(); }
  }
}
